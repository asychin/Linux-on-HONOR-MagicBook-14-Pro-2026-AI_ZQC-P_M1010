    Method (WSSL, 2, Serialized)
    {
        Switch (ToInteger (Arg0))
        {
            Case (Zero)
            {
                Switch (ToInteger (Arg1))
                {
                    Case (0x03)
                    {
                        SCMD ()
                        MP80 (0x1053)
                    }
                    Case (0x04)
                    {
                        SCMD ()
                        MP80 (0x1054)
                    }
                    Case (0x05)
                    {
                        SCMD ()
                        MP80 (0x1055)
                    }

                }
            }
            Case (One)
            {
                Switch (ToInteger (Arg1))
                {
                    Case (0x03)
                    {
                        WD80 (0x1093)
                    }
                    Case (0x04)
                    {
                        WD80 (0x1094)
                    }
                    Case (0x05)
                    {
                        WD80 (0x1095)
                    }

                }
            }
            Case (0x02)
            {
                Switch (ToInteger (Arg1))
                {
                    Case (0x03)
                    {
                        WD80 (0x10E3)
                    }
                    Case (0x04)
                    {
                        WD80 (0x10E4)
                    }
                    Case (0x05)
                    {
                        WD80 (0x10E5)
                    }

                }
            }
            Case (0x03)
            {
                Switch (ToInteger (Arg1))
                {
                    Case (0x03)
                    {
                        WD80 (0x10F3)
                    }
                    Case (0x04)
                    {
                        WD80 (0x10F4)
                    }
                    Case (0x05)
                    {
                        WD80 (0x10F5)
                    }

                }
            }

        }
    }

    Method (RCMD, 1, Serialized)
    {
        OperationRegion (CMOS, SystemIO, 0x72, 0x02)
        Field (CMOS, AnyAcc, NoLock, Preserve)
        {
            HIND,   8, 
            HDAT,   8
        }

        HIND = Arg0
        Local0 = HDAT /* \RCMD.HDAT */
        Return (Local0)
    }

    Method (WCMD, 2, Serialized)
    {
        OperationRegion (CMOS, SystemIO, 0x72, 0x02)
        Field (CMOS, AnyAcc, NoLock, Preserve)
        {
            HIND,   8, 
            HDAT,   8
        }

        HIND = Arg0
        HDAT = Arg1
    }

    Method (MCMD, 1, Serialized)
    {
        WCMD (0xF2, RCMD (0xF0))
        WCMD (0xF3, RCMD (0xF1))
        WCMD (0xF0, (Arg0 & 0xFF))
        Local0 = (Arg0 >> 0x08)
        WCMD (0xF1, Local0)
    }

    Method (SCMD, 0, Serialized)
    {
        WCMD (0xF8, RCMD (0xF0))
        WCMD (0xF9, RCMD (0xF1))
        WCMD (0xFA, RCMD (0xF2))
        WCMD (0xFB, RCMD (0xF3))
        WCMD (0xFC, RCMD (0xF4))
        WCMD (0xFD, RCMD (0xF5))
        WCMD (0xFE, RCMD (0xF6))
        WCMD (0xFF, RCMD (0xF7))
    }

    Method (MMMD, 1, Serialized)
    {
        WCMD (0xF2, (Arg0 & 0xFF))
        Local0 = (Arg0 >> 0x08)
        WCMD (0xF3, Local0)
    }

    Method (MPMD, 1, Serialized)
    {
        WCMD (0xF0, (Arg0 & 0xFF))
        Local0 = (Arg0 >> 0x08)
        WCMD (0xF1, Local0)
    }

    Method (OD80, 1, Serialized)
    {
        OperationRegion (PRT0, SystemIO, 0x80, 0x02)
        Field (PRT0, WordAcc, Lock, Preserve)
        {
            P80B,   16
        }

        MCMD (Arg0)
        P80B = Arg0
    }

    Method (WD80, 1, Serialized)
    {
        OperationRegion (PRT0, SystemIO, 0x80, 0x02)
        Field (PRT0, WordAcc, Lock, Preserve)
        {
            P80B,   16
        }

