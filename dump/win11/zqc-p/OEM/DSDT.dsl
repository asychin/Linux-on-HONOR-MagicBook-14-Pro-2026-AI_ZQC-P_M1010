    Method (MP80, 1, Serialized)
    {
        OperationRegion (PRT0, SystemIO, 0x80, 0x02)
        Field (PRT0, WordAcc, Lock, Preserve)
        {
            P80B,   16
        }

        MPMD (Arg0)
        P80B = Arg0
    }

    Method (HSMI, 0, NotSerialized)
    {
        SSMP = 0xC1
    }

    Method (GVER, 1, NotSerialized)
    {
        DAIN = Arg0
        HSMI ()
        Return (DAOU) /* External reference */
    }

    Method (GTSI, 1, NotSerialized)
    {
        Name (BUFF, Buffer (0x0100){})
        CreateByteField (BUFF, Zero, STAT)
        STAT = Zero
        CreateByteField (BUFF, One, TSB0)
        CreateByteField (BUFF, 0x02, TSB1)
        CreateByteField (BUFF, 0x03, TSB2)
        CreateByteField (BUFF, 0x04, TSB3)
        CreateByteField (BUFF, 0x05, TSB4)
        CreateByteField (BUFF, 0x06, TSB5)
        TSB0 = 0xA1
        TSB1 = 0xC9
        TSB2 = Zero
        TSB3 = 0xC0
        TSB4 = 0xFE
        TSB5 = 0x09
        Return (BUFF) /* \GTSI.BUFF */
    }

    Method (GTMP, 1, Serialized)
    {
        Name (BUFF, Buffer (0x0100){})
        CreateByteField (BUFF, Zero, STAT)
        STAT = Zero
        Local0 = Arg0
        CreateByteField (Local0, 0x02, TSSN)
        CreateByteField (BUFF, One, SIGN)
        CreateByteField (BUFF, 0x02, TSE1)
        CreateByteField (BUFF, 0x03, TSE2)
        Switch (TSSN)
        {
            Case (Zero)
            {
                TSE1 = \_SB.PC00.LPCB.LXEC.CDTS
            }
            Case (0x05)
            {
                TSE1 = \_SB.PC00.LPCB.LXEC.SCTS
            }
            Case (0x07)
            {
                TSE1 = \_SB.PC00.LPCB.LXEC.TCTS
            }
            Case (0x08)
            {
                TSE1 = \_SB.PC00.LPCB.LXEC.CHTS
            }
            Case (0x0B)
            {
                TSE1 = \_SB.PC00.LPCB.LXEC.DDRS
            }
            Case (0x0E)
            {
                TSE1 = \_SB.PC00.LPCB.LXEC.BTND
            }
            Case (0x0F)
            {
                TSE1 = \_SB.PC00.LPCB.LXEC.ABNT
            }
            Case (0x1E)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSAT / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSAT % 0x0A)
            }
            Case (0x1F)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSH1 / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSH1 % 0x0A)
            }
            Case (0x21)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSLT / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSLT % 0x0A)
            }
            Case (0x22)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSRT / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSRT % 0x0A)
            }
            Case (0x23)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSK1 / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSK1 % 0x0A)
            }
            Case (0x24)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSK2 / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSK2 % 0x0A)
            }
            Case (0x25)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSLP / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSLP % 0x0A)
            }
            Case (0x26)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSRP / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSRP % 0x0A)
            }
            Case (0x27)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSTT / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSTT % 0x0A)
            }
            Case (0x28)
            {
                TSE1 = (\_SB.PC00.LPCB.LXEC.VSVC / 0x0A)
                TSE2 = (\_SB.PC00.LPCB.LXEC.VSVC % 0x0A)
            }
            Case (0x2B)
            {
                TSE1 = \_SB.PC00.LPCB.LXEC.ESVT
            }
            Default
            {
                STAT = One
            }

        }

        Return (BUFF) /* \GTMP.BUFF */
    }

    Method (STMT, 1, Serialized)
    {
        Name (BUFF, Buffer (0x0100){})
        CreateByteField (BUFF, Zero, STAT)
        STAT = Zero
        Local0 = Arg0
        CreateByteField (Local0, 0x02, INSN)
        CreateByteField (Local0, 0x04, SIGH)
        CreateByteField (Local0, 0x05, TMHL)
        CreateByteField (Local0, 0x06, SIGL)
        CreateByteField (Local0, 0x07, TMLL)
        If (((SIGH > One) || (SIGL > One)))
        {
            STAT = One
            Return (BUFF) /* \STMT.BUFF */
        }

        Switch (INSN)
        {
            Case (Zero)
            {
                \_SB.PC00.LPCB.LXEC.CDTU = TMHL /* \STMT.TMHL */
                \_SB.PC00.LPCB.LXEC.CDTL = TMLL /* \STMT.TMLL */
                \_SB.PC00.LPCB.LXEC.CDUP = SIGH /* \STMT.SIGH */
                \_SB.PC00.LPCB.LXEC.CDLP = SIGL /* \STMT.SIGL */
            }
            Case (0x05)
            {
                \_SB.PC00.LPCB.LXEC.SCTU = TMHL /* \STMT.TMHL */
                \_SB.PC00.LPCB.LXEC.SCTL = TMLL /* \STMT.TMLL */
                \_SB.PC00.LPCB.LXEC.SCUP = SIGH /* \STMT.SIGH */
                \_SB.PC00.LPCB.LXEC.SCLP = SIGL /* \STMT.SIGL */
            }
            Case (0x07)
            {
                \_SB.PC00.LPCB.LXEC.TCTU = TMHL /* \STMT.TMHL */
                \_SB.PC00.LPCB.LXEC.TCTL = TMLL /* \STMT.TMLL */
                \_SB.PC00.LPCB.LXEC.TCUP = SIGH /* \STMT.SIGH */
                \_SB.PC00.LPCB.LXEC.TCLP = SIGL /* \STMT.SIGL */
            }
            Case (0x08)
            {
                \_SB.PC00.LPCB.LXEC.CGTU = TMHL /* \STMT.TMHL */
                \_SB.PC00.LPCB.LXEC.CGTL = TMLL /* \STMT.TMLL */
                \_SB.PC00.LPCB.LXEC.CGUP = SIGH /* \STMT.SIGH */
                \_SB.PC00.LPCB.LXEC.CGLP = SIGL /* \STMT.SIGL */
            }
            Case (0x0B)
            {
                \_SB.PC00.LPCB.LXEC.DRTU = TMHL /* \STMT.TMHL */
                \_SB.PC00.LPCB.LXEC.DRUP = SIGH /* \STMT.SIGH */
                \_SB.PC00.LPCB.LXEC.DRLP = SIGL /* \STMT.SIGL */
            }
            Case (0x0F)
            {
                \_SB.PC00.LPCB.LXEC.ABTU = TMHL /* \STMT.TMHL */
                \_SB.PC00.LPCB.LXEC.ABTL = TMLL /* \STMT.TMLL */
                \_SB.PC00.LPCB.LXEC.ABUP = SIGH /* \STMT.SIGH */
                \_SB.PC00.LPCB.LXEC.ABLP = SIGL /* \STMT.SIGL */
            }
            Case (0x2B)
            {
                \_SB.PC00.LPCB.LXEC.CRTU = TMHL /* \STMT.TMHL */
                \_SB.PC00.LPCB.LXEC.CRTL = TMLL /* \STMT.TMLL */
                \_SB.PC00.LPCB.LXEC.CRUP = SIGH /* \STMT.SIGH */
                \_SB.PC00.LPCB.LXEC.CRLP = SIGL /* \STMT.SIGL */
            }
            Default
            {
                STAT = One
            }

        }

        Return (BUFF) /* \STMT.BUFF */
    }

