                        PEPV = Zero
                    }

                    If (CondRefOf (\_SB.PEPD.RPCO))
                    {
                        PEPV = RPCO (PEPV, ^^PC02.RP26.PXSX.GRPT ())
                    }
                }

                PDIN ("\\_SB.PC02", "RP26", PEPV)
                PEPV = Zero
                If (CondRefOf (\_SB.PC02.RP27))
                {
                    ADBG ("RP27")
                    ADBG (Concatenate ("PCIe Address:", ToHexString (^^PC02.RP27._ADR)))
                    PEPV = 0x05
                    If (^^PC02.RP27.PXSX.PRES ())
                    {
                        PEPV = One
                    }

                    If ((((^^PC02.RP27.VDID >> 0x10) & 0xFFFF) == 0xB07F))
                    {
                        PEPV = Zero
                    }

                    If (CondRefOf (\_SB.PEPD.RPCO))
                    {
                        PEPV = RPCO (PEPV, ^^PC02.RP27.PXSX.GRPT ())
                    }
                }

                PDIN ("\\_SB.PC02", "RP27", PEPV)
                PEPV = Zero
                If (CondRefOf (\_SB.PC02.RP28))
                {
                    ADBG ("RP28")
                    ADBG (Concatenate ("PCIe Address:", ToHexString (^^PC02.RP28._ADR)))
                    PEPV = 0x05
                    If (^^PC02.RP28.PXSX.PRES ())
                    {
                        PEPV = One
                    }

                    If ((((^^PC02.RP28.VDID >> 0x10) & 0xFFFF) == 0xB07F))
                    {
                        PEPV = Zero
                    }

                    If (CondRefOf (\_SB.PEPD.RPCO))
                    {
                        PEPV = RPCO (PEPV, ^^PC02.RP28.PXSX.GRPT ())
                    }
                }

                PDIN ("\\_SB.PC02", "RP28", PEPV)
                Local0 = DEVC /* \_SB_.PEPD.DEVC */
                While ((Local0 < DEVS))
                {
                    PDIN ("Reserved", ToDecimalString (Local0), 0x05)
                    Local0 += One
                }
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                ADBG ("Pep _DSM!")
                If ((Arg0 == ToUUID ("c4eb40a0-6cd2-11e2-bcfd-0800200c9a66") /* Unknown UUID */))
                {
                    If ((Arg2 == Zero))
                    {
                        Return (Buffer (One)
                        {
                             0x7F                                             // .
                        })
                    }

                    If ((Arg2 == One))
                    {
                        If ((S0ID == Zero))
                        {
                            Return (Package (0x00){})
                        }

                        If ((IPDI == Zero))
                        {
                            UPDV ()
                            IPDI = One
                        }
                        Else
                        {
                            ADBG ("PEP DEVY is already initialized !!! ")
                        }

                        Return (DEVY) /* \_SB_.PEPD.DEVY */
                    }

                    If ((Arg2 == 0x02))
                    {
                        Return (BCCD) /* \_SB_.PEPD.BCCD */
                    }

                    If ((Arg2 == 0x03))
                    {
                        If (CondRefOf (\_SB.PC00.IMNG))
                        {
                            ^^PC00.IMNG (Arg2)
                        }

                        OperationRegion (COMD, SystemMemory, 0xFE02F000, 0xFF)
                        Field (COMD, AnyAcc, NoLock, Preserve)
                        {
                            CMID,   32, 
                            Offset (0x10), 
                            CBAR,   64, 
                            Offset (0x84), 
                            PWST,   2, 
                            Offset (0x85)
                        }

                        OperationRegion (UAB0, SystemMemory, (CBAR & 0xFFFFFFFFFFFFF000), 0x06)
                        Field (UAB0, ByteAcc, Lock, Preserve)
                        {
                            DLL,    8, 
                            DLH,    8, 
                            FCR,    8, 
                            LCR,    8, 
                            MCR,    8
                        }

                        If ((CMID == 0xE4268086))
                        {
                            If ((PWST == Zero))
                            {
                                If (((DLH == Zero) & (MCR == 0x02)))
                                {
                                    UPS3 (One, 0xFE02F000)
                                }
                            }
                        }

                        If ((S0ID == One))
                        {
                            D8XH (Zero, 0xC5)
                            D8XH (One, Zero)
                        }
                    }

                    If ((Arg2 == 0x04))
                    {
                        If (CondRefOf (\_SB.PC00.IMNG))
                        {
                            ^^PC00.IMNG (Arg2)
                        }

                        If ((S0ID == One))
                        {
                            D8XH (Zero, 0xC5)
                            D8XH (One, 0xAB)
                        }
                    }

                    If ((Arg2 == 0x05))
                    {
                        ADBG ("[PEP] deep standby entry")
                        PESB (One)
                    }

                    If ((Arg2 == 0x06))
                    {
                        ADBG ("[PEP] deep standby exit")
                        PESB (Zero)
                    }
                }

                Return (Buffer (One)
                {
                     0x00                                             // .
                })
            }
        }
    }

