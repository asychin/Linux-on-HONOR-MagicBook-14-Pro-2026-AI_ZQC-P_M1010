                    Else
                    {
                        STAT = One
                        RPST = One
                    }
                }
                Else
                {
                    STAT = One
                    BPST = One
                }
            }
            Else
            {
                STAT = One
                MSTS = One
            }
        }
        Else
        {
            STAT = One
            USTS = One
        }

        Return (BUFF) /* \RSBT.BUFF */
    }

