                ADBG (Concatenate ("PG3 ACET value =", ToHexString (ACET)))
                ADBG (Concatenate ("PG3 DCET value =", ToHexString (DCET)))
                \_SB.PC00.LPCB.PGWD (ACWA, DCWA, ACET, DCET)
                \_SB.PC00.LPCB.PGCL ()
            }
        }

        If (CondRefOf (\_SB.TPM.PTS))
        {
            \_SB.TPM.PTS (Arg0)
        }

        SPTS (Arg0)
        WSSL (One, Arg0)
    }

    Method (PBCL, 0, NotSerialized)
    {
        Return (Package (0x67)
        {
            0x50, 
            0x32, 
            Zero, 
            One, 
            0x02, 
            0x03, 
            0x04, 
