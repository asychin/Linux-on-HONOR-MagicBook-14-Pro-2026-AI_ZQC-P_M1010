                                SBTI (Zero)
                                ADBG ("BT: de-assert BT_IF_SELECT")
                                Sleep (0xA0)
                                SBTI (One)
                                ADBG ("BT: assert BT_IF_SELECT")
                                SBTE (One)
                                ADBG ("BT: assert BT_EN")
                                Sleep (0xA0)
                            }

                            If ((CondRefOf (RSTT) && (RSTT == One)))
                            {
                                ADBG ("BT Product Reset")
                                If (((PCRR (PCNV, 0x80) & 0x02) == Zero))
                                {
