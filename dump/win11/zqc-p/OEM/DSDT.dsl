    Scope (_SB.PC00)
    {
        If ((CRFP == One))
        {
            If ((CWFC == One))
            {
                Device (CNVW)
                {
                    Name (_ADR, 0x00140003)  // _ADR: Address
                    Name (PU2C, Zero)
                    PU2C = \PU2C
                    Method (BASE, 0, NotSerialized)
                    {
                        Local0 = PC2M (_ADR, Zero)
                        Return (Local0)
                    }

                    Method (_PS0, 0, Serialized)  // _PS0: Power State 0
                    {
                        ADBG ("CNVW Ctrlr D0")
