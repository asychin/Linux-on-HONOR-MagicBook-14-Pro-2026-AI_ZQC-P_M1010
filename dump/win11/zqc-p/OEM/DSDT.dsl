        Name (_HID, "ABCD0000")  // _HID: Hardware ID
        Name (_CID, EisaId ("PNP0C15") /* Docking Station */)  // _CID: Compatible ID
        Name (_UID, "VIRTUALDOCK")  // _UID: Unique ID
        If ((S0ID == Zero))
        {
            Method (_EJ0, 1, NotSerialized)  // _EJx: Eject Device, x=0-9
            {
                P8XH (Zero, 0xED)
            }
        }

        Method (_STA, 0, NotSerialized)  // _STA: Status
        {
            ADBG ("Method _STA")
            If (!CondRefOf (\_SB.PC00.LPCB.H_EC))
            {
                Return (Zero)
            }

            If (DSTS)
            {
                ADBG ("Virtual Dock Attached")
                Return (0x0F)
            }
            Else
            {
                ADBG ("Virtual Dock Unattahced")
                Return (Zero)
            }
        }

        If ((S0ID == Zero))
        {
            Method (_DCK, 1, NotSerialized)  // _DCK: Dock Present
            {
                ADBG ("Method _DCK")
                If (Arg0)
                {
                    Return (One)
                }
                Else
                {
                    DSTS = Zero
                    Return (One)
                }
            }
        }

        If (CondRefOf (\_SB.PC00.SAT0))
        {
            Name (XEDL, Package (0x01)
            {
                SAT0
            })
        }
    }

