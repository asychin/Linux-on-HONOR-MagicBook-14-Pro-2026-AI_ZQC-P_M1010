                                Name (_UID, "IICT")  // _UID: Unique ID
                                Name (_HID, "IIC0001")  // _HID: Hardware ID
                                Name (_CID, "IIC0001")  // _CID: Compatible ID
                                Method (_CRS, 0, NotSerialized)  // _CRS: Current Resource Settings
                                {
                                    Name (VICT, ResourceTemplate ()
                                    {
                                        I2cSerialBusV2 (0x0000, ControllerInitiated, 0x00400000,
                                            AddressingMode7Bit, "\\_SB.PC00.XHCI.RHUB.HS03.VIC0",
                                            0x00, ResourceConsumer, _Y4A, Exclusive,
                                            )
                                    })
                                    CreateWordField (VICT, \_SB.PC00.XHCI.RHUB.HS03.VIC0.IICT._CRS._Y4A._ADR, DAD2)  // _ADR: Address
                                    DAD2 = 0x76
                                    Return (VICT) /* \_SB_.PC00.XHCI.RHUB.HS03.VIC0.IICT._CRS.VICT */
                                }
                            }
