        Field (PREG, AnyAcc, NoLock, Preserve)
        {
            VEND,   16, 
            DEVC,   16, 
            IOSP,   1, 
            MEMS,   1, 
            BUSM,   1, 
            Offset (0x05), 
            Offset (0x10), 
            MBAR,   32
