# Rebuild the HONOR MagicBook kernel-module fixes whenever a kernel is installed
# or upgraded. Without this, a kernel update silently reverts them.
#
# Installed by patch/auto-rebuild/install.sh into /etc/pacman.d/hooks/.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Rebuilding HONOR MagicBook kernel module fixes...
When = PostTransaction
Exec = /usr/local/lib/honor/rebuild.sh modules
NeedsTargets
