[Unit]
Description=Re-apply the HONOR HID-BPF mic-mute fixup after udev settles
Documentation=file:/usr/local/lib/honor/hid-bpf-reapply.sh
After=multi-user.target
ConditionPathExists=/etc/honor-micmute.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/honor/hid-bpf-reapply.sh

[Install]
WantedBy=multi-user.target
